---
/**
 * Hero glass card — CSS-only, no WebGL.
 * The cosmic background shines through via backdrop-filter, giving a natural
 * prism-through-glass effect without a second WebGL context.
 */
export interface Props {
  heroBillboard?: boolean;
}
const { heroBillboard = false } = Astro.props;
---

<div
  class:list={[
    'prism-glass-card relative w-full overflow-hidden rounded-3xl',
    'border border-white/20 bg-white/[0.06]',
    'backdrop-blur-2xl',
    'shadow-[0_8px_64px_-16px_rgba(0,0,0,0.18),inset_0_1px_0_rgba(255,255,255,0.18)]',
    heroBillboard ? 'p-7 md:p-8' : 'p-6',
  ]}
>
  <!-- Animated rainbow shimmer overlay — mimics prism light through glass -->
  <div class="prism-card-shimmer absolute inset-0 pointer-events-none" aria-hidden="true" />

  <!-- Corner glints -->
  <div class="absolute top-0 left-0 w-20 h-20 bg-gradient-to-br from-cyan-400/10 to-transparent rounded-tl-3xl pointer-events-none" aria-hidden="true" />
  <div class="absolute bottom-0 right-0 w-24 h-24 bg-gradient-to-tl from-fuchsia-400/8 to-transparent rounded-br-3xl pointer-events-none" aria-hidden="true" />

  <div class="relative z-10 flex flex-col h-full">
    <!-- Logomark + identity -->
    <div class="flex items-center gap-3">
      <div class="prism-logo-pulse relative flex items-center justify-center w-11 h-11 rounded-xl bg-black/5 border border-black/8">
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" aria-hidden="true">
          <defs>
            <linearGradient id="pgv1" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
              <stop offset="0%"   stop-color="#22d3ee"/>
              <stop offset="50%"  stop-color="#d946ef"/>
              <stop offset="100%" stop-color="#fbbf24"/>
            </linearGradient>
          </defs>
          <polygon points="16,3 29,10.5 29,21.5 16,29 3,21.5 3,10.5" fill="none" stroke="url(#pgv1)" stroke-width="1.5"/>
          <polygon points="16,8 24,12.5 24,19.5 16,24 8,19.5 8,12.5"  fill="none" stroke="url(#pgv1)" stroke-width="0.8" opacity="0.45"/>
          <circle cx="16" cy="16" r="2.5" fill="url(#pgv1)"/>
        </svg>
      </div>
      <div>
        <div class="text-sm font-black tracking-tight text-[#0D0D0D]">PrsmStudios</div>
        <div class="text-[10px] text-[#0D0D0D]/40 tracking-[0.18em] uppercase font-semibold">
          Digital Consulting
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="mt-6 h-px bg-black/8" />

    <!-- Studio stats grid -->
    <div class="mt-5 grid grid-cols-2 gap-3">
      <div class="rounded-xl bg-black/[0.03] border border-black/6 px-3.5 py-3">
        <div class="text-xl font-black tracking-tight text-[#0D0D0D]">3</div>
        <div class="mt-0.5 text-[9px] font-semibold uppercase tracking-[0.25em] text-[#0D0D0D]/40">
          Core Services
        </div>
      </div>
      <div class="rounded-xl bg-black/[0.03] border border-black/6 px-3.5 py-3">
        <div class="text-xl font-black tracking-tight text-[#0D0D0D]">2+</div>
        <div class="mt-0.5 text-[9px] font-semibold uppercase tracking-[0.25em] text-[#0D0D0D]/40">
          Active Clients
        </div>
      </div>
    </div>

    <!-- Capabilities list -->
    <div class="mt-4 flex flex-wrap gap-1.5">
      {['Brand Reframing', 'Experience Eng.', 'Venture Deploy'].map(tag => (
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[9px] font-semibold uppercase tracking-[0.18em] bg-black/[0.04] border border-black/8 text-[#0D0D0D]/50">
          {tag}
        </span>
      ))}
    </div>

    <!-- Spacer -->
    <div class="flex-1 min-h-4" />

    <!-- Status pill -->
    <div class="mt-4 flex items-center gap-2">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span class="text-[9px] font-semibold uppercase tracking-[0.28em] text-[#0D0D0D]/40">
        Available for new ventures
      </span>
    </div>
  </div>
</div>

<style>
  /* Slow-moving rainbow shimmer that mimics prism light diffraction */
  .prism-card-shimmer {
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(34, 211, 238, 0.04) 45%,
      rgba(217, 70, 239, 0.03) 55%,
      rgba(251, 191, 36, 0.03) 65%,
      transparent 70%
    );
    background-size: 300% 300%;
    animation: prism-shimmer 8s ease-in-out infinite;
  }

  @keyframes prism-shimmer {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .prism-logo-pulse {
    animation: logo-glow 4s ease-in-out infinite;
  }

  @keyframes logo-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(34, 211, 238, 0); }
    50%       { box-shadow: 0 0 16px 2px rgba(34, 211, 238, 0.12); }
  }
</style>
