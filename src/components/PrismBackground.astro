---

<!-- Aurora wash — beneath the WebGL canvas. Large blurred color fields that
     drift slowly, so even "empty" areas of the page glow with moving color. -->
<div data-aurora class="fixed inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
  <div class="aurora-blob aurora-blob--cyan"></div>
  <div class="aurora-blob aurora-blob--magenta"></div>
  <div class="aurora-blob aurora-blob--gold"></div>
</div>

<div data-prism-bg class="fixed inset-0 z-[1] pointer-events-none">
  <canvas data-prism-canvas class="w-full h-full block"></canvas>
</div>

<script>
  import '@scripts/cosmicBackground.ts';
</script>

<style>
  .aurora-blob {
    position: absolute;
    width: 55vw;
    height: 55vw;
    border-radius: 9999px;
    filter: blur(90px);
    will-change: transform;
  }

  .aurora-blob--cyan {
    background: radial-gradient(circle, rgba(34, 211, 238, 0.16), transparent 65%);
    top: -10%;
    left: -15%;
    animation: aurora-drift-1 26s ease-in-out infinite;
  }

  .aurora-blob--magenta {
    background: radial-gradient(circle, rgba(217, 70, 239, 0.13), transparent 65%);
    top: 30%;
    right: -20%;
    animation: aurora-drift-2 32s ease-in-out infinite;
  }

  .aurora-blob--gold {
    background: radial-gradient(circle, rgba(251, 191, 36, 0.11), transparent 65%);
    bottom: -20%;
    left: 20%;
    animation: aurora-drift-3 38s ease-in-out infinite;
  }

  @keyframes aurora-drift-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(12vw, 8vh) scale(1.15); }
    66%      { transform: translate(4vw, 16vh) scale(0.95); }
  }

  @keyframes aurora-drift-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(-14vw, -6vh) scale(1.1); }
    66%      { transform: translate(-6vw, 10vh) scale(1.2); }
  }

  @keyframes aurora-drift-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50%      { transform: translate(10vw, -12vh) scale(1.18); }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora-blob { animation: none; }
  }

  /* Mobile: smaller blur radius — blur(90px) on huge elements is GPU-expensive */
  @media (max-width: 1024px) {
    .aurora-blob { filter: blur(60px); width: 80vw; height: 80vw; }
  }
</style>
