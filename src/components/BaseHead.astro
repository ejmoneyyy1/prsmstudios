---
/**
 * Strategic SEO + social metadata for prsmstudios.io (high-intent digital transformation).
 */
import {
  OG_IMAGE,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_URL,
} from '../consts';

interface Props {
  /** Full document title (browser tab + og:title) */
  title: string;
  /** Meta + og:description + twitter:description */
  description?: string;
  /** Homepage / marketing vs case-study depth pages */
  ogType?: 'website' | 'article';
  /** Path under public/, e.g. `/og-image.png` */
  ogImagePath?: string;
  /** Canonical page URL (include trailing slash policy to match deployment) */
  canonicalURL: URL;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogType = 'website',
  ogImagePath = OG_IMAGE,
  canonicalURL,
} = Astro.props;

const pageUrl = canonicalURL.href;
const imageUrl = new URL(ogImagePath, SITE_URL).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={pageUrl} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<meta name="theme-color" content="#16213e" />

<!-- GSC verified via DNS — no HTML tag needed -->

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={pageUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={`${SITE_NAME} — digital transformation & venture deployment`} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      "name": SITE_NAME,
      "url": SITE_URL,
      "logo": {
        "@type": "ImageObject",
        "url": `${SITE_URL}/favicon.svg`,
        "contentUrl": `${SITE_URL}/favicon.svg`
      },
      "image": {
        "@type": "ImageObject",
        "url": imageUrl
      },
      "description": SITE_DESCRIPTION,
      "email": "eaalobuia@gmail.com",
      "sameAs": [
        "https://www.linkedin.com/in/earl-alobuia-995318220/",
        "https://www.instagram.com/ej.moneyyy/"
      ],
      "knowsAbout": [
        "Brand Strategy",
        "Digital Transformation",
        "Venture Deployment",
        "Experience Engineering",
        "Web Development",
        "Mobile App Development"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      "url": SITE_URL,
      "name": SITE_NAME,
      "description": SITE_DESCRIPTION,
      "publisher": { "@id": `${SITE_URL}/#organization` }
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${SITE_URL}/#website` },
      "about": { "@id": `${SITE_URL}/#organization` }
    }
  ]
})} />
