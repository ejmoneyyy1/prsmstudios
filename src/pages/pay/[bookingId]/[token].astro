---
export const prerender = false;

const CHECKOUT_ENDPOINT =
  'https://us-central1-pulse-e2941.cloudfunctions.net/createManualBookingCheckout';

// TODO: replace with real store IDs once the app is published
const APP_STORE_URL = 'https://apps.apple.com/app/idXXXXXXXXXX';
const PLAY_URL = 'https://play.google.com/store/apps/details?id=com.citypulse.app';

const { bookingId, token } = Astro.params;

// Keep the bearer token out of Referer headers sent to Stripe / third parties.
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

let alreadyPaid = false;
let errorMessage: string | null = null;

if (bookingId && token) {
  try {
    const r = await fetch(
      `${CHECKOUT_ENDPOINT}?bookingId=${encodeURIComponent(bookingId)}&token=${encodeURIComponent(token)}`
    );
    const data: { url?: string; error?: string; message?: string } =
      await r.json().catch(() => ({}));

    if (r.ok && data.url) {
      // Happy path: redirect straight to Stripe-hosted checkout.
      return Astro.redirect(data.url, 303);
    }

    alreadyPaid = data.error === 'already_paid';
    errorMessage = data.message ?? 'This payment link is no longer valid.';
  } catch {
    errorMessage = 'Something went wrong starting checkout. Please try again.';
  }
} else {
  errorMessage = 'Missing payment details.';
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex" />
    <title>Pulse — Appointment payment</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #0B0F14;
        color: #fff;
        display: grid;
        place-items: center;
        min-height: 100svh;
      }
      .wrap {
        max-width: 360px;
        width: 100%;
        padding: 40px 24px;
        text-align: center;
      }
      .icon { font-size: 48px; margin-bottom: 16px; }
      h1 { font-size: 22px; font-weight: 700; margin: 0 0 8px; letter-spacing: -0.3px; }
      .sub { color: #9AA4B2; line-height: 1.55; margin: 0 0 32px; font-size: 15px; }
      .divider { height: 1px; background: rgba(255,255,255,0.08); margin: 28px 0; }
      .get-app p { color: #6B7280; font-size: 13px; margin: 0 0 14px; }
      .btn {
        display: block;
        padding: 14px 16px;
        margin: 10px 0;
        border-radius: 14px;
        background: #1B2430;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        font-size: 15px;
        border: 1px solid rgba(255,255,255,0.08);
        transition: background 0.15s;
      }
      .btn:hover { background: #232E3E; }
    </style>
  </head>
  <body>
    <main class="wrap">
      {alreadyPaid ? (
        <>
          <div class="icon">✓</div>
          <h1>You're all set</h1>
          <p class="sub">This appointment has already been paid — nothing left to do.</p>
        </>
      ) : (
        <>
          <div class="icon">🔗</div>
          <h1>Payment link unavailable</h1>
          <p class="sub">{errorMessage}</p>
        </>
      )}

      <div class="divider"></div>

      <div class="get-app">
        <p>Get the Pulse app to book and track appointments.</p>
        <a href={APP_STORE_URL} class="btn">Download on the App Store</a>
        <a href={PLAY_URL} class="btn">Get it on Google Play</a>
      </div>
    </main>
  </body>
</html>
